{
  "expo": {
    "name": "Babá de Família Rica",
    "slug": "baba-familia-rica",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "br.com.babafamiliarica.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FBF8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "br.com.babafamiliarica.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização só para registrar a entrada no atendimento."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Para escolher sua foto de perfil e enviar documentos.",
          "cameraPermission": "Para tirar a selfie e fotografar documentos da verificação."
        }
      ],
      "expo-video"
    ],
    "scheme": "babafamiliarica",
    "experiments": {
      "typedRoutes": true
    }
  }
}